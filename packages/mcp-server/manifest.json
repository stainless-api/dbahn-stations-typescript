{
  "dxt_version": "0.2",
  "name": "dbahn-stations-mcp",
  "version": "0.0.1",
  "description": "The official MCP Server for the Dbahn Stations API",
  "author": {
    "name": "Dbahn Stations",
    "email": "StaDa.API@deutschebahn.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stainless-sdks/dbahn-stations-typescript.git"
  },
  "homepage": "https://github.com/stainless-sdks/dbahn-stations-typescript/tree/main/packages/mcp-server#readme",
  "documentation": "https://docs.dbahn-stations.com",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "DBAHN_STATIONS_CLIENT_ID": "${user_config.DBAHN_STATIONS_CLIENT_ID}",
        "DBAHN_STATIONS_CLIENT_SECRET": "${user_config.DBAHN_STATIONS_CLIENT_SECRET}"
      }
    }
  },
  "user_config": {
    "DBAHN_STATIONS_CLIENT_ID": {
      "title": "client_id",
      "description": "",
      "required": true,
      "type": "string"
    },
    "DBAHN_STATIONS_CLIENT_SECRET": {
      "title": "client_secret",
      "description": "",
      "required": true,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": ["api"]
}
